@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container hero-container">
        <div class="hero-content">
            <h2>Take Control of Your <span class="highlight">Career Journey</span></h2>
            <p class="hero-text">Our comprehensive platform empowers students to:</p>
            <ul class="feature-list">
                <li>Track every internship and job application in one place</li>
                <li>Visualize your progress with interactive dashboards</li>
                <li>Stay organized throughout your professional development</li>
                <li>Learn from application patterns and improve your approach</li>
            </ul>
            <div class="cta-buttons">
                <a href="~/Create" class="btn btn-primary">Get Started</a>
                <a href="~/Visualizations" class="btn btn-secondary">Demo</a>
            </div>
        </div>
        <div class="hero-image">
            <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1471&q=80"
                 alt="Students collaborating on career planning"
                 loading="lazy" />
        </div>
    </div>
</section>

