@model MyMvcApp.Models.Application

@{
    ViewData["Title"] = "Delete Application";
}

<main class="container">
    <div class="card">
        <h2>Delete Application</h2>

        <div class="delete-confirmation">
            <div class="warning-message">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003zM12 8.25a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V9a.75.75 0 01.75-.75zm0 8.25a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" />
                </svg>
                <h3>Are you sure you want to delete this application?</h3>
            </div>

            <div class="application-details">
                <p><strong>Company:</strong> @Model.CompanyName</p>
                <p><strong>Position:</strong> @Model.PositionTitle</p>
                <p><strong>Date Applied:</strong> @Model.ApplicationDate.ToString("MMMM dd, yyyy")</p>
                <p><strong>Status:</strong> <span class="status-badge">@Model.Status</span></p>
            </div>

            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" asp-for="ApplicationId" />
                <div class="delete-actions">
                    <a asp-action="Index" class="btn btn-outline">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-danger">
                        Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

<footer>
    <div class="container">
        <p>&copy; 2025 Student Internship & Job App System</p>
    </div>
</footer>
